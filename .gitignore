# Dependencies
node_modules/
.npm/

# VitePress build artifacts
.vitepress/dist/
.vitepress/cache/

# Generated content
# /public/examples/ is populated by scripts/prepare-examples.mjs from /examples/
# at build time. Don't commit the generated copies.
/public/examples/
# /examples/0N-*.md viewing pages are also generated by prepare-examples.mjs.
# The .xdbml source files and README.md are committed; the generated .md
# viewing wrappers are not.
/examples/0*.md
# /public/playground/ is populated by scripts/prepare-playground.mjs from
# /playground/dist/ at build time. Generated copy, not committed.
/public/playground/
# The playground has its own build output too; gitignored alongside.
/playground/dist/
/playground/.vite/
/playground/public/xdbml-*.svg

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local environment
.env
.env.local
